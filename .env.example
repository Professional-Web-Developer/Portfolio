# Portfolio guide (the "Ask about Kavin" chat widget, POST /api/chat)
#
# Copy to .env.local for local development. Never commit real values.
#
# The guide is OFF unless BOTH are true:
#   1. GUIDE_ENABLED is "true" or "1", and
#   2. an AI Gateway credential exists: AI_GATEWAY_API_KEY, or a Vercel OIDC
#      token (VERCEL_OIDC_TOKEN).
# When off, the launcher is not rendered or loaded and /api/chat returns 404.
#
# The home page is prerendered, so this is decided at build time: after
# changing these values, redeploy (Vercel) or run `npm run build` again.
#
# Credentials:
# - On Vercel: usually nothing to set. Deployments authenticate to the gateway
#   with the project's OIDC token, once AI Gateway is enabled for the team
#   (Vercel dashboard > AI Gateway). Add a spend budget there too.
# - Locally: either set AI_GATEWAY_API_KEY below, or run `vercel link` and
#   `vercel env pull` to get a short-lived VERCEL_OIDC_TOKEN in .env.local.
#
# If a live gateway call fails, the guide answers from a built-in, rule-based
# responder (src/lib/guide/local-responder.js).

# Turn the guide on: true or 1. Anything else (or unset) keeps it off.
GUIDE_ENABLED=

# AI Gateway API key (Vercel dashboard > AI Gateway > API keys). Local/non-Vercel only.
AI_GATEWAY_API_KEY=

# Optional: override the gateway model id ("provider/model").
# Defaults to the value of DEFAULT_MODEL_ID in src/lib/guide/config.js.
GUIDE_MODEL=

# Optional: set to 1 to never call a model and always use the built-in responder.
GUIDE_LOCAL_ONLY=
