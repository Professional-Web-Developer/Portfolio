# Portfolio guide (the "Ask about Kavin" chat widget, POST /api/chat)
#
# Copy to .env.local for local development. Never commit real values.
#
# The guide calls its model through the Vercel AI Gateway.
# - On Vercel: nothing to set. Deployments authenticate to the gateway with
#   the project's OIDC token automatically, once AI Gateway is enabled for the
#   team (Vercel dashboard > AI Gateway). Add a spend budget there too.
# - Locally: either set AI_GATEWAY_API_KEY below, or run `vercel link` and
#   `vercel env pull` to get a short-lived VERCEL_OIDC_TOKEN in .env.local.
#
# With no credentials, or if the gateway call fails, the guide answers from
# a built-in, rule-based responder (src/lib/guide/local-responder.js), so the
# widget always works.

# AI Gateway API key (Vercel dashboard > AI Gateway > API keys). Local/non-Vercel only.
AI_GATEWAY_API_KEY=

# Optional: override the gateway model id ("provider/model").
# Defaults to the value of DEFAULT_MODEL_ID in src/lib/guide/config.js.
GUIDE_MODEL=

# Optional: set to 1 to never call a model and always use the built-in responder.
GUIDE_LOCAL_ONLY=
